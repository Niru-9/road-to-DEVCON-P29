{
  "name": "qf-round-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Indexer, eligibility proofs, and verifiable results API for the quadratic funding round",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/cli/migrate.ts",
    "sync": "tsx src/cli/sync.ts",
    "round:add": "tsx src/cli/round-add.ts",
    "eligibility:import": "tsx src/cli/import-eligibility.ts",
    "verify": "tsx src/cli/verify.ts",
    "configure:round": "node scripts/configure-round.mjs",
    "migrate:built": "node dist/cli/migrate.js",
    "sync:built": "node dist/cli/sync.js",
    "round:add:built": "node dist/cli/round-add.js",
    "eligibility:import:built": "node dist/cli/import-eligibility.js",
    "verify:built": "node dist/cli/verify.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "better-sqlite3": "^13.0.3",
    "commander": "^14.0.2",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "pino": "^10.1.0",
    "viem": "^2.57.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
