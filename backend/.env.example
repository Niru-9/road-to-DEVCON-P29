# ---------------------------------------------------------------------------
# Backend configuration. Copy to `.env` and fill in locally. Never commit `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info

# SQLite database file. Docker uses /app/data/qf.db by default.
DATABASE_PATH=./data/qf.db

# Sepolia by default. Any EVM chain id works.
CHAIN_ID=11155111
# Public endpoint by default. Set your own (possibly authenticated) RPC in `.env`
# only — authenticated RPC URLs are credentials and must never be committed.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional bootstrap round. Can also be added through POST /api/v1/admin/rounds.
ROUND_ADDRESS=
ROUND_START_BLOCK=
ROUND_NAME=Road to Devcon Quadratic Round

# Indexer
INDEXER_ENABLED=true
INDEXER_POLL_MS=15000
INDEXER_CONFIRMATIONS=2
INDEXER_BATCH_BLOCKS=4000

# Admin API. Leave empty to disable every /api/v1/admin route.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# Comma-separated list, or * for any origin. The frontend is intentionally not
# part of this milestone, but CORS is ready for it.
CORS_ORIGINS=*

# Public rate limiting
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
