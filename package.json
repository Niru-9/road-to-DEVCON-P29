{
  "name": "qf-round-contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Quadratic funding round contracts and verifiable results backend",
  "scripts": {
    "build": "forge build",
    "test": "forge test -vvv",
    "fmt": "forge fmt",
    "compile:solc": "solcjs --bin --abi --optimize --base-path . --include-path node_modules -o contracts/solc-out contracts/src/QuadraticFundingRound.sol",
    "flatten:remix": "node scripts/flatten.mjs contracts/src/QuadraticFundingRound.sol contracts/remix/QuadraticFundingRound.sol"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "forge-std": "1.1.2",
    "solc": "0.8.24"
  }
}
